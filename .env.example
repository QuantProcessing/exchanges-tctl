# tctl — trader exchange control tool
# Configure credentials for the exchanges you want to use.
# tctl auto-detects the exchange if only one is configured.

# --- Binance ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# BINANCE_QUOTE_CURRENCY=USDT  # USDT (default) or USDC

# --- OKX ---
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# OKX_QUOTE_CURRENCY=USDT  # USDT (default) or USDC

# --- Lighter ---
# LIGHTER_PRIVATE_KEY=
# LIGHTER_ACCOUNT_INDEX=
# LIGHTER_KEY_INDEX=
# LIGHTER_RO_TOKEN=
# LIGHTER_QUOTE_CURRENCY=USDC  # USDC (only supported)

# --- Hyperliquid ---
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_ACCOUNT_ADDR=  # optional; derived from private key when omitted
# HYPERLIQUID_QUOTE_CURRENCY=USDC  # USDC (only supported)

# --- Nado ---
# NADO_PRIVATE_KEY=
# NADO_SUB_ACCOUNT_NAME=
# NADO_QUOTE_CURRENCY=USDT  # USDT (only supported)

# --- Aster ---
# ASTER_API_KEY=
# ASTER_SECRET_KEY=
# ASTER_QUOTE_CURRENCY=USDT  # USDT (default) or USDC

# --- StandX ---
# STANDX_PRIVATE_KEY=
# STANDX_QUOTE_CURRENCY=DUSD  # DUSD (only supported)

# --- EdgeX ---
# EDGEX_PRIVATE_KEY=
# EDGEX_ACCOUNT_ID=
# EDGEX_QUOTE_CURRENCY=USDC  # USDC (only supported)

# --- GRVT ---
# GRVT_API_KEY=
# GRVT_SUB_ACCOUNT_ID=
# GRVT_PRIVATE_KEY=
# GRVT_QUOTE_CURRENCY=USDT  # USDT (only supported)
