# tctl — trader exchange control tool
# Configure credentials for the exchanges you want to use.
# tctl auto-detects the exchange if only one is configured.

# --- Binance ---
EXCHANGES_BINANCE_API_KEY=
EXCHANGES_BINANCE_SECRET_KEY=
# EXCHANGES_BINANCE_QUOTE_CURRENCY=USDT  # USDT (default) or USDC

# --- OKX ---
# EXCHANGES_OKX_API_KEY=
# EXCHANGES_OKX_SECRET_KEY=
# EXCHANGES_OKX_PASSPHRASE=
# EXCHANGES_OKX_QUOTE_CURRENCY=USDT  # USDT (default) or USDC

# --- Lighter ---
# EXCHANGES_LIGHTER_PRIVATE_KEY=
# EXCHANGES_LIGHTER_ACCOUNT_INDEX=
# EXCHANGES_LIGHTER_KEY_INDEX=
# EXCHANGES_LIGHTER_RO_TOKEN=
# EXCHANGES_LIGHTER_QUOTE_CURRENCY=USDC  # USDC (only supported)

# --- Hyperliquid ---
# EXCHANGES_HYPERLIQUID_PRIVATE_KEY=
# EXCHANGES_HYPERLIQUID_ACCOUNT_ADDR=
# EXCHANGES_HYPERLIQUID_QUOTE_CURRENCY=USDC  # USDC (only supported)

# --- Nado ---
# EXCHANGES_NADO_PRIVATE_KEY=
# EXCHANGES_NADO_SUB_ACCOUNT_NAME=
# EXCHANGES_NADO_QUOTE_CURRENCY=USDT  # USDT (only supported)

# --- Aster ---
# EXCHANGES_ASTER_API_KEY=
# EXCHANGES_ASTER_SECRET_KEY=
# EXCHANGES_ASTER_QUOTE_CURRENCY=USDC  # USDC (default) or USDT

# --- StandX ---
# EXCHANGES_STANDX_PRIVATE_KEY=
# EXCHANGES_STANDX_QUOTE_CURRENCY=DUSD  # DUSD (only supported)

# --- EdgeX ---
# EXCHANGES_EDGEX_PRIVATE_KEY=
# EXCHANGES_EDGEX_ACCOUNT_ID=
# EXCHANGES_EDGEX_QUOTE_CURRENCY=USDC  # USDC (only supported)

# --- GRVT ---
# EXCHANGES_GRVT_API_KEY=
# EXCHANGES_GRVT_SUB_ACCOUNT_ID=
# EXCHANGES_GRVT_PRIVATE_KEY=
# EXCHANGES_GRVT_QUOTE_CURRENCY=USDT  # USDT (only supported)
